				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>シェルスクリプトを実行</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>OUT="$HOME/Desktop/900px"
mkdir -p "$OUT"

for f in "$@"; do
  name=$(basename "$f")
  /usr/bin/sips -Z 900 -s dpiWidth 300 -s dpiHeight 300 "$f" --out "$OUT/$name" &gt;/dev/null
done
</string>
